;;; liberime-regexp-segment-test.el --- Segmentation tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'liberime-regexp)

(defmacro liberime-segment-test--dictionary (&rest body)
  "Run BODY with deterministic weighted dictionary entries."
  (declare (indent 0) (debug t))
  `(let ((liberime-regexp--segment-cache (make-hash-table :test #'equal))
         (liberime-regexp--segment-cache-order (make-ring 256))
         (liberime-regexp-cache-size 256)
         (liberime-regexp-segment-max-word-length 8)
         (liberime-regexp-segment-combination-limit 64)
         (liberime-regexp-segment-candidate-limit 128)
         (dictionary '(("研究" . -2.0) ("研究生" . -3.0) ("生命" . -2.0)
                       ("命" . -8.0) ("𠀀研" . -2.0)))
         (schema "test") calls)
     (cl-letf (((symbol-function 'liberime-regexp--segment-ensure-session) #'ignore)
               ((symbol-function 'liberime-regexp-load-liberime) #'ignore)
               ((symbol-function 'liberime-get-status)
                (lambda (&optional _) (list (cons 'schema_id schema))))
               ((symbol-function 'liberime-regexp--segment-request)
                (lambda (text source limits)
                  (push (list text source limits) calls)
                  (let (edges)
                    (dolist (entry dictionary)
                      (let ((start 0) (word (car entry)))
                        (while (string-match (regexp-quote word) text start)
                          (let ((begin (match-beginning 0)) (end (match-end 0)))
                            (when (<= (- end begin) (car limits))
                              (push (vector begin end (cdr entry)) edges))
                            (setq start (1+ begin))))))
                    edges))))
       ,@body)))

(ert-deftest liberime-segment-test-ambiguity-and-unknown-characters ()
  (liberime-segment-test--dictionary
    (should (equal (liberime-regexp-split-string "研究生命龘") '("研究" "生命" "龘")))
    (should (equal (liberime-regexp-segment "研究生命") '((0 . 2) (2 . 4))))))

(ert-deftest liberime-segment-test-mixed-text-and-character-offsets ()
  (liberime-segment-test--dictionary
    (with-temp-buffer
      (should (equal (liberime-regexp-segment " abc𠀀研究 42，生命!")
                     '((1 . 4) (4 . 6) (6 . 7) (8 . 10) (11 . 13))))
      (modify-syntax-entry ?_ "w")
      (should (equal (liberime-regexp-split-string "foo_bar研究") '("foo_bar" "研究"))))))

(ert-deftest liberime-segment-test-empty-text-does-not-need-rime ()
  (cl-letf (((symbol-function 'liberime-regexp-load-liberime)
             (lambda () (ert-fail "Unexpected Rime access"))))
    (should-not (liberime-regexp-segment ""))
    (should-not (liberime-regexp-segment " ，!\n"))
    (should (equal (liberime-regexp-split-string "foo 123") '("foo" "123")))))

(ert-deftest liberime-segment-test-score-ties-and-known-single-character ()
  ;; Equal score prefers fewer tokens, then the earlier longer token.
  (should (equal (liberime-regexp--segment-best-path
                  3 '([0 1 -2] [1 3 -2] [0 2 -2] [2 3 -2])) '((0 . 2) (2 . 3))))
  (should (equal (liberime-regexp--segment-best-path
                  2 '([0 1 -2] [1 2 -2] [0 2 -4])) '((0 . 2))))
  ;; An existing rare single character must not be replaced by fallback -30.
  (should (equal (liberime-regexp--segment-best-path
                  2 '([0 1 -100] [1 2 -1] [0 2 -80])) '((0 . 2)))))

(ert-deftest liberime-segment-test-overlapping-chunks-have-global-boundaries ()
  (liberime-segment-test--dictionary
    (let* ((text (concat (make-string 63 ?龘) "研究生命"))
           (ranges (liberime-regexp-segment text)))
      (should (= (length ranges) 65))
      (should (equal (last ranges 2) '((63 . 65) (65 . 67))))
      (should (cl-every (lambda (call) (<= (length (car call)) 64)) calls)))))

(ert-deftest liberime-segment-test-cache-keys-limits-schema-and-eviction ()
  (liberime-segment-test--dictionary
    (setq liberime-regexp-cache-size 1)
    (let ((first (liberime-regexp-segment "研究生命")))
      (setcar (car first) 100)
      (should (equal (liberime-regexp-segment "研究生命") '((0 . 2) (2 . 4))))
    (should (= (length calls) 1))
    (liberime-regexp-segment "研究生命" "other")
    (should (= (length calls) 2))
    (setq liberime-regexp-segment-max-word-length 1)
    (should (= (length (liberime-regexp-segment "研究生命" "other")) 4))
    (should (= (length calls) 3))
    (should (= (hash-table-count liberime-regexp--segment-cache) 1))
    (liberime-regexp-clear-cache)
    (should (= (hash-table-count liberime-regexp--segment-cache) 0))
    (setq liberime-regexp-cache-size 0)
    (liberime-regexp-segment "研究")
    (liberime-regexp-segment "研究")
    (should (= (hash-table-count liberime-regexp--segment-cache) 0)))))

(ert-deftest liberime-segment-test-limits-are-validated ()
  (liberime-segment-test--dictionary
    (dolist (invalid '(0 65 -1 nil 1.5))
      (let ((liberime-regexp-segment-max-word-length invalid))
        (should-error (liberime-regexp-segment "研究") :type 'wrong-type-argument)))))

(ert-deftest liberime-segment-test-movement-negative-args-and-narrowing ()
  (liberime-segment-test--dictionary
    (with-temp-buffer
      (insert "x研究生命 word！")
      (narrow-to-region 2 6)
      (goto-char (point-min))
      (should (liberime-regexp-forward-word 2))
      (should (= (point) 6))
      (liberime-regexp-forward-word -1)
      (should (= (point) 4))
      (liberime-regexp-backward-word)
      (should (= (point) 2))
      (should-not (liberime-regexp-backward-word))
      (should (= (point) 2))
      (liberime-regexp-backward-word -1)
      (should (= (point) 4))
      (liberime-regexp-forward-word 0)
      (should (= (point) 4))
      (widen)
      (liberime-regexp-forward-word 2)
      (should (= (point) 11))
      (should-not (liberime-regexp-forward-word))
      (should (= (point) (point-max))))))

(ert-deftest liberime-segment-test-killing-marking-and-word-at-point ()
  (liberime-segment-test--dictionary
    (with-temp-buffer
      (insert "研究生命 word")
      (goto-char 2)
      (should (equal (liberime-regexp-word-at-point) "研究"))
      (goto-char 3)
      (should (equal (liberime-regexp-word-at-point) "生命"))
      (goto-char 5)
      (should (equal (liberime-regexp-word-at-point) "生命"))
      (goto-char 10)
      (should (equal (liberime-regexp-word-at-point) "word"))
      (goto-char 1)
      (liberime-regexp-mark-word 1)
      (should (= (mark) 3))
      (let ((last-command 'liberime-regexp-mark-word) (this-command 'liberime-regexp-mark-word))
        (liberime-regexp-mark-word nil t))
      (should (= (mark) 5))
      (goto-char 5)
      (liberime-regexp-mark-word -1)
      (let ((last-command 'liberime-regexp-mark-word) (this-command 'liberime-regexp-mark-word))
        (liberime-regexp-mark-word nil t))
      (should (= (mark) 1))
      (let ((kill-ring nil))
        (liberime-regexp-backward-kill-word 1)
        (should (equal (buffer-string) "研究 word"))
        (should (equal (car kill-ring) "生命"))
        (goto-char 1)
        (liberime-regexp-kill-word 1)
        (should (equal (buffer-string) " word"))))))

(ert-deftest liberime-segment-test-word-at-punctuation-and-adjacent-scripts ()
  (liberime-segment-test--dictionary
    (with-temp-buffer
      (insert "abc, 研究xyz")
      (goto-char 4)
      (should (equal (liberime-regexp-word-at-point) "abc"))
      (goto-char 5)
      (should-not (liberime-regexp-word-at-point))
      (goto-char 8)
      (should (equal (liberime-regexp-word-at-point) "xyz"))
      (narrow-to-region 6 6)
      (should-not (liberime-regexp-word-at-point)))))

(ert-deftest liberime-segment-test-ascii-transport-and-protocol-errors ()
  (let ((liberime-regexp--segment-session 42)
        (reply '("[0,2,-3.5]" "done")) request)
    (cl-letf (((symbol-function 'liberime-search)
               (lambda (code limit index schema full-context session)
                 (should (= session 42))
                 (should-not (or limit index schema full-context))
                 (setq request code)
                 reply)))
      (should (equal (liberime-regexp--segment-request "研究" "test" '(8 64 128))
                     '([0 2 -3.5])))
      (should (equal request "74657374g8g64g128ge7a094e7a9b6z"))
      (dolist (invalid '(nil ("[0,1,-2]")))
        (setq reply invalid)
        (should-error (liberime-regexp--segment-request "研究" "test" '(8 64 128)) :type 'user-error))
      (setq reply (list (propertize "error" :comment "Missing dictionary")))
      (should (equal (cdr (should-error (liberime-regexp--segment-request "研究" "test" '(8 64 128))
                                       :type 'user-error))
                     '("Rime segmentation: Missing dictionary")))
      (setq reply '("not json" "done"))
      (should-error (liberime-regexp--segment-request "研究" "test" '(8 64 128)) :type 'json-parse-error))))

(ert-deftest liberime-segment-test-mode-remaps-and-releases-session ()
  (let ((liberime-regexp--segment-session 42) destroyed)
    (cl-letf (((symbol-function 'liberime-session-destroy) (lambda (id) (setq destroyed id))))
      (unwind-protect
          (progn
            (liberime-regexp-segment-mode 1)
            (dolist (command '(forward-word backward-word kill-word backward-kill-word mark-word))
              (should (eq (command-remapping command)
                          (intern (concat "liberime-regexp-" (symbol-name command)))))))
        (liberime-regexp-segment-mode -1))
      (should (= destroyed 42))
      (should-not liberime-regexp--segment-session))))
