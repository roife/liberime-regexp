;;; liberime-regexp-test.el --- Tests for liberime-regexp  -*- lexical-binding: t; -*-

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'liberime-regexp)

(define-error 'rimeerr "Rime error")

(defmacro liberime-regexp-test--with-rime (&rest body)
  "Run BODY with isolated caches and a mock Rime."
  (declare (indent 0) (debug t))
  `(let ((liberime-regexp--candidate-cache (make-hash-table :test #'equal))
         (liberime-regexp--cache-order (make-ring 256))
         (liberime-regexp--schema-options nil)
         (liberime-regexp--query-session nil)
         (liberime-regexp-cache-size 256)
         (liberime-regexp-candidate-limit 100)
         (liberime-regexp-max-code-length 0)
         (schema "test")
         (options (make-hash-table :test #'equal))
         (sessions (make-hash-table))
         (serial 0)
         created destroyed searches option-writes
         (expansions '(:commit nil :full ("你") :prefix nil
                       :remainder nil :remaining-input "ni")))
     (cl-letf (((symbol-function 'liberime-regexp-load-liberime) #'ignore)
               ((symbol-function 'liberime-get-status)
                (lambda (&optional session)
                  (let ((id (if session (gethash session sessions) schema)))
                    (unless id (signal 'rimeerr '(1 "Expired session")))
                    (cons (cons 'schema_id id)
                          (mapcar (lambda (entry)
                                    (cons (cdr entry)
                                          (gethash (car entry) options)))
                                  liberime-regexp--status-options)))))
               ((symbol-function 'liberime-get-switches)
                (lambda ()
                  '(("ascii_mode" nil nil nil)
                    ("custom" nil nil nil)
                    ("first" nil nil ("first" "second")))))
               ((symbol-function 'liberime-get-option)
                (lambda (option) (gethash option options)))
               ((symbol-function 'liberime-set-option)
                (lambda (option value &optional session)
                  (push (list option value session) option-writes)))
               ((symbol-function 'liberime-session-create)
                (lambda (&optional id)
                  (setq serial (1+ serial))
                  (puthash serial id sessions)
                  (push (cons serial id) created)
                  serial))
               ((symbol-function 'liberime-session-destroy)
                (lambda (session)
                  (push session destroyed)
                  (remhash session sessions)))
               ((symbol-function 'liberime-search)
                (lambda (code &optional limit index id full-context session)
                  (should (gethash session sessions))
                  (push (list code limit index id full-context session) searches)
                  (copy-tree expansions))))
       ,@body)))

(ert-deftest liberime-regexp-test-cache-evicts-only-the-oldest-query ()
  (liberime-regexp-test--with-rime
    (setq liberime-regexp-cache-size 2)
    (dolist (code '("a" "b" "a" "c" "b"))
      (liberime-regexp--query-code code))
    (should (= (length searches) 3))
    (should (= (hash-table-count liberime-regexp--candidate-cache) 2))
    (liberime-regexp--query-code "a")
    (should (= (length searches) 4))))

(ert-deftest liberime-regexp-test-cache-resizes-without-losing-retained-queries ()
  (liberime-regexp-test--with-rime
    (setq liberime-regexp-cache-size 3)
    (dolist (code '("a" "b" "c" "d"))
      (liberime-regexp--query-code code))
    (setq liberime-regexp-cache-size 2)
    (liberime-regexp--query-code "e")
    (liberime-regexp--query-code "d")
    (should (= (length searches) 5))
    (should (= (hash-table-count liberime-regexp--candidate-cache) 2))
    (setq liberime-regexp-cache-size 4)
    (liberime-regexp--query-code "f")
    (liberime-regexp--query-code "d")
    (liberime-regexp--query-code "e")
    (should (= (length searches) 6))
    (should (= (hash-table-count liberime-regexp--candidate-cache) 3))))

(ert-deftest liberime-regexp-test-clear-cache-requeries-with-the-same-session ()
  (liberime-regexp-test--with-rime
    (liberime-regexp--query-code "ni")
    (liberime-regexp-clear-cache)
    (should (= (hash-table-count liberime-regexp--candidate-cache) 0))
    (liberime-regexp--query-code "ni")
    (should (= (length searches) 2))
    (should (= (length created) 1))))

(ert-deftest liberime-regexp-test-disabled-cache-bypasses-old-entries ()
  (liberime-regexp-test--with-rime
    (liberime-regexp--query-code "ni")
    (setq expansions '(:full ("泥") :remaining-input "ni"))
    (dolist (size '(0 -1))
      (setq liberime-regexp-cache-size size)
      (should (equal (plist-get (liberime-regexp--query-code "ni") :full)
                     '("泥"))))
    (should (= (length searches) 3))
    (should (= (hash-table-count liberime-regexp--candidate-cache) 1))))

(ert-deftest liberime-regexp-test-batch-reuses-session-and-normalizes ()
  (liberime-regexp-test--with-rime
    (setq expansions '(:full ("你" "" "你") :prefix ("甲" "甲")
                       :remainder "i" :remaining-input "ni"))
    (puthash "full_shape" t options)
    (puthash "custom" t options)
    (puthash "second" t options)
    (let ((first (liberime-regexp--query-code "ni")))
      (should (equal (plist-get first :full) '("你")))
      (should (equal (plist-get first :prefix) '("甲")))
      (should (eq first (liberime-regexp--query-code "n'i"))))
    (liberime-regexp--query-code "hao")
    (should (equal created '((1 . "test"))))
    (should (equal (reverse searches)
                   '(("ni" 100 nil nil t 1) ("hao" 100 nil nil t 1))))
    (dolist (option '(("full_shape" t 1) ("ascii_mode" nil 1)
                      ("custom" t 1) ("first" nil 1) ("second" t 1)))
      (should (member option option-writes)))))

(ert-deftest liberime-regexp-test-cache-key-includes-switch-options ()
  (liberime-regexp-test--with-rime
    (liberime-regexp--query-code "ni")
    (puthash "custom" t options)
    (setq expansions '(:full ("泥") :remaining-input "ni"))
    (should (equal (plist-get (liberime-regexp--query-code "ni") :full)
                   '("泥")))
    (remhash "custom" options)
    (should (equal (plist-get (liberime-regexp--query-code "ni") :full)
                   '("你")))
    (puthash "ascii_punct" t options)
    (liberime-regexp--query-code "ni")
    (should (= (length searches) 3))
    (should (= (length created) 1))))

(ert-deftest liberime-regexp-test-batch-recreates-session-on-schema-change ()
  (liberime-regexp-test--with-rime
    (liberime-regexp--query-code "ni")
    (setq schema "other")
    (liberime-regexp--query-code "ni")
    (should (equal (reverse created) '((1 . "test") (2 . "other"))))
    (should (equal destroyed '(1)))
    (should (eq liberime-regexp--query-session 2))))

(ert-deftest liberime-regexp-test-batch-recreates-expired-session ()
  (liberime-regexp-test--with-rime
    (liberime-regexp--query-code "ni")
    (clrhash sessions)
    (liberime-regexp--query-code "hao")
    (should (= (length created) 2))
    (should (eq liberime-regexp--query-session 2))))

(ert-deftest liberime-regexp-test-batch-normalizes-unlimited-candidate-limit ()
  (liberime-regexp-test--with-rime
    (dolist (limit '(nil 0 -1))
      (setq liberime-regexp-candidate-limit limit)
      (liberime-regexp-clear-cache)
      (liberime-regexp--query-code "ni")
      (should-not (nth 1 (car searches))))))

(ert-deftest liberime-regexp-test-empty-batch-result-is-cached ()
  (liberime-regexp-test--with-rime
    (setq expansions '(:full nil :remaining-input "unknown"))
    (should-not (liberime-regexp--query-code "unknown"))
    (should-not (liberime-regexp--query-code "unknown"))
    (should (= (length searches) 1))))

(ert-deftest liberime-regexp-test-batch-errors-propagate-without-caching ()
  (liberime-regexp-test--with-rime
    (cl-letf (((symbol-function 'liberime-search)
               (lambda (&rest _) (error "Query failed"))))
      (should-error (liberime-regexp--query-code "ni"))
      (should (= (hash-table-count liberime-regexp--candidate-cache) 0)))))

(ert-deftest liberime-regexp-test-only-complete-commits-are-exposed ()
  (liberime-regexp-test--with-rime
    (setq expansions '(:commit "前缀" :remaining-input "unconsumed"))
    (should-not (liberime-regexp-get-candidates-list "unknown"))
    (setq expansions '(:commit "完整" :remaining-input ""))
    (should (equal (liberime-regexp-get-candidates-list "whole") '("完整")))
    (setq expansions '(:commit "前缀" :full ("后缀") :remaining-input "suffix"))
    (should (equal (liberime-regexp-get-candidates-list "code")
                   '("前缀" "后缀")))))

(ert-deftest liberime-regexp-test-rime-restart-discards-old-state ()
  (liberime-regexp-test--with-rime
    (liberime-regexp--query-code "ni")
    (run-hooks 'liberime-after-start-hook)
    (should-not liberime-regexp--query-session)
    (should-not liberime-regexp--schema-options)
    (should (= (hash-table-count liberime-regexp--candidate-cache) 0))))

(ert-deftest liberime-regexp-test-disabling-mode-releases-session ()
  (liberime-regexp-test--with-rime
    (liberime-regexp--query-code "ni")
    (let ((liberime-regexp-mode t))
      (cl-letf (((symbol-function 'liberime-regexp--remove-integrations) #'ignore))
        (liberime-regexp-mode -1)))
    (should-not liberime-regexp--query-session)
    (should (equal destroyed '(1)))
    (should (= (hash-table-count liberime-regexp--candidate-cache) 0))))

(ert-deftest liberime-regexp-test-composes-without-prefix-only-match ()
  (let ((whole-query
         (list :commit nil :full '("整词") :prefix '("甲" "假")
               :remainder "cd" :remaining-input "abcd"
               :regexp-code nil :regexp nil))
        (suffix-query
         (list :commit nil :full '("乙") :prefix nil
               :remainder nil :remaining-input "cd"
               :regexp-code nil :regexp nil)))
    (cl-letf (((symbol-function 'liberime-regexp--query-code)
               (lambda (code)
                 (if (string= code "abcd") whole-query suffix-query))))
      (let ((regexp (liberime-regexp--code-regexp "abcd")))
        (should (string-match-p (concat "\\`" regexp "\\'") "甲乙"))
        (should (string-match-p (concat "\\`" regexp "\\'") "整词"))
        (should (string-match-p (concat "\\`" regexp "\\'") "abcd"))
        (should-not (string-match-p (concat "\\`" regexp "\\'") "甲"))
        (should (eq regexp (liberime-regexp--code-regexp "abcd")))))))

(ert-deftest liberime-regexp-test-avy-char-2-uses-combined-code ()
  (let (builder-args jump-args)
    (cl-letf (((symbol-function 'liberime-regexp-build-regexp-string)
               (lambda (&rest args)
                 (setq builder-args args)
                 "expanded"))
              ((symbol-function 'avy-jump)
               (lambda (&rest args)
                 (setq jump-args args))))
      (liberime-regexp-avy-goto-char-2 ?n ?i 'flip 10 20)
      (should (equal builder-args '("ni" t)))
      (should (equal jump-args
                     '("expanded" :window-flip flip :beg 10 :end 20))))))

(ert-deftest liberime-regexp-test-avy-timer-uses-rime-builder ()
  (let (builder-args processed)
    (cl-letf (((symbol-function 'liberime-regexp-build-regexp-string)
               (lambda (&rest args)
                 (setq builder-args args)
                 "expanded"))
              ((symbol-function 'avy--read-candidates)
               (lambda (builder)
                 (should (equal (funcall builder "ni") "expanded"))
                 'candidates))
              ((symbol-function 'avy-process)
               (lambda (candidates)
                 (setq processed candidates))))
      (liberime-regexp-avy-goto-char-timer)
      (should (equal builder-args '("ni" t)))
      (should (eq processed 'candidates)))))

(ert-deftest liberime-regexp-test-avy-mode-remaps-commands ()
  (unwind-protect
      (progn
        (liberime-regexp-avy-mode 1)
        (should (eq (command-remapping 'avy-goto-char)
                    #'liberime-regexp-avy-goto-char))
        (should (eq (command-remapping 'avy-goto-char-timer)
                    #'liberime-regexp-avy-goto-char-timer)))
    (liberime-regexp-avy-mode -1)))

(provide 'liberime-regexp-test)

;;; liberime-regexp-test.el ends here
